# MongoDB Atlas Connection String (Required)
# Get this from MongoDB Atlas dashboard: https://www.mongodb.com/cloud/atlas
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/?appName=Cluster0

# JWT Configuration
JWT_SECRET=your-secret-key-here-change-this-in-production
JWT_EXPIRES_IN=7d

# Admin Credentials (for initial seeding)
ADMIN_EMAIL=admin@mediconnect.com
ADMIN_PASSWORD=Admin123!

# Server Configuration
NODE_ENV=development
PORT=5000

# Frontend URL (for CORS configuration)
# For local development:
CLIENT_URL=http://localhost:5173

# For Render production, use the deployed static site origin.
# CLIENT_URLS=https://your-render-frontend.onrender.com
# or multiple origins separated by commas:
# CLIENT_URLS=http://localhost:5173,https://your-render-frontend.onrender.com

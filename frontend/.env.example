# Frontend API Configuration

# Development: Points to local backend server
VITE_API_URL=http://localhost:5000/api

# Production: Update to your deployed backend URL
# VITE_API_URL=https://your-backend-service.onrender.com/api

# If you omit VITE_API_URL in production, the app will fall back to '/api',
# which only works when the frontend and backend are served from the same origin.
